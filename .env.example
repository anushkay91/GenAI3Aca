# GEMINI_API_KEY: Required for server-side Gemini AI content generation.
# Set in Google Cloud Secret Manager or environment variables.
GEMINI_API_KEY=

# GEMINI_MODEL: Optional model alias or full model name (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# FIREBASE_PROJECT_ID: Firebase project ID for server-side token authentication
FIREBASE_PROJECT_ID=genai3-506610

# PORT: Server listener port (container default is 3000)
PORT=3000

# APP_URL: The public URL where this applet is hosted.
APP_URL=
